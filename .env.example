# LLM provider (see docs/configuration.md for all presets)
# minimax example — base_url comes from the provider preset, no need to set it.
LLM_PROVIDER=minimax
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=MiniMax-M3

# 服务监听
NEATMEM_HOST=0.0.0.0
NEATMEM_PORT=8790

# Embedding 提供商 (siliconflow / openai / dashscope / xinference)
EMBEDDING_PROVIDER=siliconflow

# Embedding API key（hosted provider 必填）
EMBEDDING_API_KEY=sk-your-embedding-key-here

# Xinference Embedding（EMBEDDING_PROVIDER=xinference 时必填）
# XINFERENCE_SERVER_URL=http://localhost:9997
# XINFERENCE_MODEL_UID=bge-m3

# 向量存储（Qdrant）
# 嵌入式模式（默认）：{NEATMEM_DIR}/qdrant，可用 QDRANT_PATH 覆盖
# QDRANT_PATH=qdrant_db
# Server 模式：设置 QDRANT_HOST 会切换到 server 模式，覆盖 QDRANT_PATH
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# 搜索信号开关（以下为默认值，一般无需设置）
# ENABLE_BM25=true
# ENABLE_ENTITY=false

# Rerank（以下为默认值，一般无需设置）
# RERANK_MODE=llm            # rerank 引擎: llm / cross_encoder / off
# LLM_RERANK_MODE=listwise   # llm 引擎: listwise(整列表筛选排序) / pointwise(逐条打分排序)
# LLM_RERANK_CANDS=20        # 送 rerank 的 head 候选数
# LLM_RERANK_CAND_TEXT_LEN=120  # 候选文本截断字符数, 0=不截断

# Cross-encoder rerank（RERANK_MODE=cross_encoder 时生效）
# CROSS_ENCODER_PROVIDER=siliconflow  # siliconflow / jina / cohere / dashscope / xinference / local
# CROSS_ENCODER_MODEL=Qwen/Qwen3-Reranker-8B   # 默认随 provider preset
# CROSS_ENCODER_API_KEY=     # 默认回落各 provider 自己的 key env（如 SILICONFLOW_API_KEY）
# CROSS_ENCODER_CANDS=100
# CROSS_ENCODER_CAND_TEXT_LEN=0
# CROSS_ENCODER_REL_THRESHOLD=0   # 0=只重排不过滤(mem0 风格); >0=丢弃低于 top_score*ratio 的候选
# CROSS_ENCODER_TIMEOUT=60
# local provider 专用（需 pip install neatmem[local-reranker]）:
# CROSS_ENCODER_DEVICE=auto       # auto / cuda / cpu
# CROSS_ENCODER_BATCH_SIZE=32

# 记忆去重（以下为默认值，一般无需设置）
# DEDUP_ENABLED=true         # false = 不去重，全部按新记忆写入
# DEDUP_RESOLVER=skip        # 判中重复后怎么处理: skip(新旧共存) / replace(覆盖) / rewrite(LLM融合) / edit(LLM patch)
# DEDUP_DETECTOR=listwise    # 怎么判: listwise(单次调用判全批) / pointwise(逐对三分类)

# 消息历史存储（默认 {NEATMEM_DIR}/messages.db）
# HISTORY_DB_PATH=qdrant_db/history.db
EXTRACT_LAST_K_MESSAGES=10
MESSAGE_STORE_BACKEND=sqlite

# Server-side write batching (queue mode): messages forwarded to
# /v1/messages/add/ are extracted in fixed-size batches by the in-process
# scheduler. See docs/configuration.md.
# MESSAGE_BATCHING_ENABLED=true
# MESSAGE_BATCH_SIZE=10
# MESSAGE_BATCH_DEADLINE_SECS=600
# MESSAGE_BATCHING_CHECK_INTERVAL_SECS=30

# Vector similarity threshold for dedup candidate recall
# DEDUP_RECALL_THRESHOLD=0.40

# Entity 提取与存储
ENTITY_EXTRACTOR_BACKEND=ner
ENTITY_STORE_BACKEND=qdrant

# HuggingFace 镜像（fastembed BM25 模型下载）
HF_ENDPOINT=https://hf-mirror.com
