{
  "name": "@neatmem/dsh-neatmem",
  "version": "0.1.0",
  "description": "NeatMem long-term memory plugin for DeepSeek Harness — thin REST client against a neatmem server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanhaoning/NeatMem.git",
    "directory": "dsh"
  },
  "keywords": [
    "neatmem",
    "memory",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.6.0"
  }
}
