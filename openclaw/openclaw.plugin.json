{
  "id": "openclaw-neatmem",
  "name": "Memory (NeatMem)",
  "description": "NeatMem memory backend for OpenClaw — local, controllable, mem0-compatible. Injects recalled memories into agent context (auto-recall) and extracts facts after each turn (auto-capture). Both configurable via autoRecall/autoCapture settings.",
  "version": "1.1.0",
  "kind": "memory",
  "skills": ["skills"],
  "contracts": {
    "tools": [
      "memory_search", "memory_add", "memory_get", "memory_list",
      "memory_update", "memory_delete", "memory_event_list", "memory_event_status"
    ]
  },
  "providerAuthEnvVars": {
    "neatmem": ["NEATMEM_API_KEY"]
  },
  "providerAuthChoices": [
    {
      "provider": "neatmem",
      "method": "api-key",
      "choiceId": "neatmem-api-key",
      "choiceLabel": "NeatMem API key",
      "choiceHint": "For a local NeatMem server any token works, e.g. neatmem-local.",
      "groupId": "neatmem",
      "groupLabel": "NeatMem",
      "optionKey": "apiKey",
      "cliFlag": "--neatmem-api-key",
      "cliOption": "--neatmem-api-key <key>",
      "cliDescription": "NeatMem server API token"
    }
  ],
  "uiHints": {
    "apiKey": {
      "label": "NeatMem API Key",
      "sensitive": true,
      "placeholder": "neatmem-local",
      "help": "Use a SecretRef ({\"source\":\"env\",\"provider\":\"default\",\"id\":\"NEATMEM_API_KEY\"}) or ${NEATMEM_API_KEY} instead of storing the key directly."
    },
    "userId": {
      "label": "Default User ID",
      "placeholder": "default",
      "help": "User ID for scoping memories"
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Automatically store conversation context after each agent turn"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Automatically inject relevant memories before each agent turn"
    },
    "customInstructions": {
      "label": "Custom Instructions",
      "placeholder": "Only store user preferences and important facts...",
      "help": "Natural language rules for what NeatMem should store or exclude"
    },
    "customCategories": {
      "label": "Custom Categories",
      "advanced": true,
      "help": "Map of category names to descriptions for memory tagging. Sensible defaults are built in."
    },
    "searchThreshold": {
      "label": "Search Threshold",
      "placeholder": "0.1",
      "help": "Minimum similarity score for search results (0-1). Default: 0.1"
    },
    "topK": {
      "label": "Top K Results",
      "placeholder": "5",
      "help": "Maximum number of memories to retrieve"
    },
    "skills": {
      "label": "Agentic Memory Skills",
      "advanced": true,
      "help": "Enable skills-based memory extraction. The agent controls what to remember (triage), how to recall (recall), and periodic cleanup (dream). Disables auto-capture when active."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string",
        "description": "Custom NeatMem server base URL"
      },
      "userId": {
        "type": "string"
      },
      "userEmail": {
        "type": "string"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "customInstructions": {
        "type": "string"
      },
      "customCategories": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "searchThreshold": {
        "type": "number"
      },
      "topK": {
        "type": "number"
      },
      "skills": {
        "type": "object",
        "properties": {
          "triage": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "importanceThreshold": { "type": "number" },
              "credentialPatterns": { "type": "array", "items": { "type": "string" } }
            }
          },
          "recall": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "strategy": { "type": "string", "enum": ["always", "smart", "manual"] },
              "tokenBudget": { "type": "number" },
              "maxMemories": { "type": "number" },
              "rerank": { "type": "boolean" },
              "keywordSearch": { "type": "boolean" },
              "filterMemories": { "type": "boolean" },
              "threshold": { "type": "number" },
              "identityAlwaysInclude": { "type": "boolean" },
              "categoryOrder": { "type": "array", "items": { "type": "string" } }
            }
          },
          "dream": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "auto": { "type": "boolean" },
              "minHours": { "type": "number" },
              "minSessions": { "type": "number" },
              "minMemories": { "type": "number" }
            }
          },
          "domain": { "type": "string" },
          "customRules": {
            "type": "object",
            "properties": {
              "include": { "type": "array", "items": { "type": "string" } },
              "exclude": { "type": "array", "items": { "type": "string" } }
            }
          },
          "categories": { "type": "object" }
        }
      }
    },
    "required": []
  }
}